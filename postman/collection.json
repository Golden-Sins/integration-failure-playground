  "item": [
    {
      "name": "Auth: Get Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let json;\r",
              "try {\r",
              "  json = pm.response.json();\r",
              "} catch (e) {\r",
              "  json = {};\r",
              "}\r",
              "\r",
              "pm.environment.set(\"token\", json.access_token || \"\");\r",
              "\r",
              "pm.test(\"Token request succeeded\", function () {\r",
              "  pm.expect(pm.response.code).to.eql(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Token saved to environment\", function () {\r",
              "  pm.expect(pm.environment.get(\"token\")).to.be.a(\"string\").and.not.empty;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{ \"client_id\": \"demo\", \"client_secret\": \"demo\" }",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "token"
          ]
        }
      },
      "response": []
    },
